# ============================================
# Git管理范围说明
# ============================================
# 仓库根目录: dev/
#
# 目录架构（对齐参考项目）：
#   dev/app/   = 资源整合包（EXE + _internal/ + desktop/ + ...）
#                也是 Git 管理的核心开发目录
#   dev/ver/   = 稳定版 EXE（手动从 app/ 复制）
#
# 推送内容：
# - app/ 的源代码文件 (main.py, backend.py, desktop/src/, etc.)
# - ver/*.exe (稳定版 EXE)
# - .gitignore
#
# 不推送（用户通过部署维护功能自动安装）：
# - app/nodejs/       (Node.js 运行时，~190MB)
# - app/bun/          (Bun 运行时，~104MB)
# - app/node_modules/ (npm 依赖，~500MB)
# - app/_internal/    (PyInstaller 运行时 DLL)
# - app/*.exe         (开发测试 EXE)
# - app/.venv/        (Python 虚拟环境)
# - app/.env          (含 API 密钥，敏感信息)
# ============================================

# ── app/ 下的 EXE 和 _internal/（不推送）──
app/*.exe
app/_internal/

# ── ver/ 下的稳定 EXE 要推送 ──
!ver/*.exe

# ── build/ 目录（PyInstaller 工作目录，不推送）──
/build/

# ── 运行时环境（由部署维护功能自动安装，不推送）──
app/nodejs/
app/bun/
app/node_modules/
app/.venv/
app/env_install_status.json

# ── 敏感信息 ──
app/.env
app/.env.*
!app/.env.example

# ── Python 缓存 ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
*.spec

# ── IDE / 编辑器 ──
.vscode/
.idea/
*.swp
*.swo
*~
.windsurf/
.cursorignore
.cursorindexingignore

# ── OS 生成文件 ──
Thumbs.db
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# ── 日志 ──
*.log
logs/

# ── 临时文件 ──
temp/
tmp/
*.tmp
*.bak
*.cache

# ── 大型压缩包 ──
*.zip
*.7z
*.tar.gz
*.whl

# ── 修复脚本（开发临时文件）──
app/fix_all_bundle_imports.cjs
app/fix_bundle_imports.cjs
app/fix_bundle_imports_v2.cjs
app/fix_bundle_imports_v3.cjs

# ── 版本历史（不提交到 Git）──
app/version_history.json
