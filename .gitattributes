# ============================================================
# 行尾与文本处理规则
# ------------------------------------------------------------
# 目标：文本文件入库统一按 LF 存储，避免编辑器把整文件行尾改掉
# 后产生 9338 行级别的假 diff（1.PC/app/main.py 已出现过一次）。
# ============================================================

# 默认按文本处理，二进制由 git 自动探测
* text=auto

# Windows 脚本保持 CRLF（cmd.exe / PowerShell 的默认约定）
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell 脚本保持 LF
*.sh text eol=lf

# 明确标注二进制，避免被当成文本做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.zip binary
*.7z binary
*.exe binary
*.dll binary
*.pyd binary
*.so binary
*.db binary
*.sqlite binary
*.gguf binary
*.bin binary
