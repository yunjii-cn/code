# ============================================================
# 云集智能体工作台 (AgentWork) - .gitignore
# ============================================================

# ---- Rust ----
target/
**/*.rs.bk
Cargo.lock.bak
.cargo/

# ---- Node.js / TypeScript ----
node_modules/
.pnpm-store/
.pnpm-debug.log*
dist/
build/
.next/
out/
.turbo/
.vite/
*.tsbuildinfo

# ---- Tauri ----
apps/desktop/target/
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/Cargo.lock

# ---- Cargo (workspace level) ----
# 保留根 Cargo.lock，但子项目（apps/cli 等）忽略
apps/**/Cargo.lock

# ---- 环境变量 ----
.env
.env.local
.env.*.local
.env.development
.env.production

# ---- 日志 ----
*.log
logs/
*.pid
*.seed
*.pid.lock

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- 测试 ----
coverage/
.nyc_output/
*.lcov
playwright-report/
test-results/
.next-test/

# ---- 临时文件 ----
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej
*.swp

# ---- 构建产物 ----
*.dmg
*.msi
*.deb
*.rpm
*.AppImage
*.exe
*.whl
*.tar.gz
*.zip
release/
build_artifacts/

# ---- Docker ----
docker-compose.override.yml
.docker/

# ---- 数据库 ----
*.db
*.db-journal
*.sqlite
*.sqlite-journal
data/local/

# ---- 密钥/证书 ----
*.pem
*.key
*.crt
*.p12
secrets/
.gpg/

# ---- AI 模型缓存（避免提交大文件） ----
models/
*.gguf
*.bin
*.safetensors

# ---- Skills 缓存 ----
skills/.cache/
skills/.tmp/

# ---- Runtime 临时 ----
runtime/.cache/
runtime/.tmp/

# ---- 操作系统 ----
# Windows
ehthumbs.db
ehthumbs_vista.db
$RECYCLE.BIN/
*.lnk

# macOS
.AppleDouble
.LSOverride
Icon
._*

# Linux
.fuse_hidden*
.nfs*

# ---- 备份 ----
BAK/
*.backup
*.old

# ---- 项目级忽略 ----
# 内部测试数据
tests/fixtures/private/
examples/private/
