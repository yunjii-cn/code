{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./renderer/src/*"]
    }
  },
  "include": ["renderer/src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
